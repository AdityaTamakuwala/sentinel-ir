# ==============================================================================
# SENTINEL IR — Environment Configuration Template
# Copy via `make init-env` (generates random local dev secrets) or manually to `.env`.
# NEVER commit `.env` or real credentials to version control.
# ==============================================================================

# --- Core Application ---
# Allowed values: development | testing | production
# In `production`, startup refuses default/weak secrets, demo data seeding, or debug flags.
APP_ENV=development
APP_NAME="SENTINEL IR"
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Cryptographic secrets (MUST be strong random values; `scripts/init_dev_env.py` generates these for dev)
# SECRET_KEY: >= 32 bytes random hex/base64 used for JWT signing & HMAC operations
SECRET_KEY=CHANGE_ME_GENERATE_WITH_INIT_DEV_ENV
# ENCRYPTION_KEY: 32-byte URL-safe base64 Fernet key used to encrypt integration credentials at rest
ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_KEY_WITH_INIT_DEV_ENV
# METRICS_BEARER_TOKEN: required in Authorization header (`Bearer <token>`) to scrape `/metrics`
METRICS_BEARER_TOKEN=CHANGE_ME_GENERATE_METRICS_TOKEN

# --- Authentication & Session Security ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- PostgreSQL Database (Dual Role Separation per ADR-003) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_ir
# Schema owner role (used ONLY by Alembic migrations and schema bootstrap)
POSTGRES_USER=sentinel_owner
POSTGRES_PASSWORD=CHANGE_ME_DEV_OWNER_PASSWORD
# Least-privilege runtime role (used by FastAPI & Celery; NO UPDATE/DELETE on audit_logs)
APP_DB_USER=sentinel_app
APP_DB_PASSWORD=CHANGE_ME_DEV_APP_PASSWORD

# Connection URLs (constructed matching the host/ports above)
MIGRATION_DATABASE_URL=postgresql+asyncpg://sentinel_owner:CHANGE_ME_DEV_OWNER_PASSWORD@postgres:5432/sentinel_ir
DATABASE_URL=postgresql+asyncpg://sentinel_app:CHANGE_ME_DEV_APP_PASSWORD@postgres:5432/sentinel_ir
SYNC_DATABASE_URL=postgresql+psycopg://sentinel_app:CHANGE_ME_DEV_APP_PASSWORD@postgres:5432/sentinel_ir

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Demo & Seeding Controls ---
# MUST be `false` in production (enforced at startup).
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=CHANGE_ME_DEV_DEMO_PASSWORD

# --- Alert Ingestion & Deduplication ---
DEDUPLICATION_WINDOW_MINUTES=10
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_MAX_PAYLOAD_BYTES=1048576

# --- Evidence Storage ---
# Stored outside any static/web root under random UUID keys
EVIDENCE_STORAGE_DIR=/var/lib/sentinel-ir/evidence
MAX_UPLOAD_BYTES=26214400
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Threat Intelligence Providers (Optional; falls back to clearly labeled Mock Providers) ---
ENRICHMENT_USE_MOCK_WHEN_UNCONFIGURED=true
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_RATE_LIMIT_PER_MIN=4
VIRUSTOTAL_CACHE_TTL_SECONDS=3600

ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2
ABUSEIPDB_RATE_LIMIT_PER_MIN=30
ABUSEIPDB_CACHE_TTL_SECONDS=3600

OTX_API_KEY=
OTX_BASE_URL=https://otx.alienvault.com/api/v1
OTX_RATE_LIMIT_PER_MIN=30
OTX_CACHE_TTL_SECONDS=3600

# --- Outbound Notifications (Optional Tier 2 / Tier 3) ---
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinel-ir@example.org

# --- Optional LLM-Assisted Draft Summary (Tier 3; Disabled by Default) ---
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- Frontend / Reverse Proxy ---
NEXT_PUBLIC_APP_NAME="SENTINEL IR"
INTERNAL_API_URL=http://api:8000

